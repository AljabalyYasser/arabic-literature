---
// قراءة لنص داخل الفصل: <Reading text="qifa-nabki" from={1} to={8} />
import { must, url, verseOrder, versesOf } from '../lib/content';
import VerseReader from './VerseReader.astro';

interface Props { text: string; from?: number; to?: number }
const { text, from = 1, to = Infinity } = Astro.props;
const entry = await must({ collection: 'texts', id: text });
// في القراءة الموجهة والحرة يُفتح البيت غير المشروح على مفرداته.
const inRange = (await versesOf(text)).filter((v) => verseOrder(v.id) >= from && verseOrder(v.id) <= to);
const mixed = inRange.some((v) => !v.data.explained);
const anyExplained = inRange.some((v) => v.data.explained);
---
<div class="embed reader-block">
  <p class="meta-row">
    <span>{!mixed ? 'اضغط أي بيت لتفتح شرحه.' : anyExplained ? 'اضغط البيت لتفتح مفرداته، أو شرحه الكامل إن كان حول رقمه دائرة.' : 'اضغط البيت لتفتح مفرداته.'}</span>
    <a href={url.text(entry.id)}>صفحة القصيدة كاملة</a>
  </p>
  <VerseReader text={text} from={from} to={to} scoped />
</div>
