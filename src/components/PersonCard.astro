---
import { lifespan, must, url } from '../lib/content';
import { personKinds } from '../lib/labels';

interface Props { id: string }
const p = await must({ collection: 'people', id: Astro.props.id });
---
<a class="card link-card embed" href={url.person(p.id)} style="display:block">
  <span class="kicker">{p.data.kinds.map((k) => personKinds[k]).join('، ')} · {lifespan(p.data.born, p.data.died)}</span>
  <h3>{p.data.name}</h3>
  <p>{p.data.summary}</p>
</a>
