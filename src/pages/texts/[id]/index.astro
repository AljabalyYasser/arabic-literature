---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import CiteList from '../../../components/CiteList.astro';
import VerseReader from '../../../components/VerseReader.astro';
import Body from '../../../components/Body.astro';
import { checkVerseParents, countWord, fmt, formatDate, must, ranges, sourceMap, stripCites, url, verseOrder, versesOf } from '../../../lib/content';
import Grade from '../../../components/Grade.astro';
import { readingTiers, textKinds } from '../../../lib/labels';

export async function getStaticPaths() {
  await checkVerseParents();
  return (await getCollection('texts')).map((text) => ({ params: { id: text.id }, props: { text } }));
}

const { text } = Astro.props as { text: CollectionEntry<'texts'> };
const t = text.data;
const author = t.author ? await must(t.author) : undefined;
const verses = await versesOf(text.id);
const explained = verses.filter((v) => v.data.explained);
const sources = await sourceMap();
const range = explained.length ? ranges(explained.map((v) => verseOrder(v.id))) : '';
// النص المقروء بدرجة من درجات القراءة معروض كاملًا، وفيه أبيات غير مشروحة تُفتح على مفرداتها.
const mixed = explained.length < verses.length;
---
<Base title={t.title} description={stripCites(t.occasion)} searchType={textKinds[t.kind]}>
  <Crumbs items={[{ href: '/texts/', label: 'النصوص' }, { label: t.title }]} />
  <div class="entity-head with-aside">
    <header>
      <span class="kicker">{textKinds[t.kind]}{author && <> · <a href={url.personOf(author)}>{author.data.name}</a></>}</span>
      <h1>{t.title}</h1>
      {t.occasion && <p class="lede" set:html={fmt(t.occasion, sources)} />}
      <div class="meta-row">
        {t.attribution && <Grade of="text" grade={t.attribution.grade} note={stripCites(t.attribution.note)} />}
        {t.reading && <span class="badge plain" title={readingTiers[t.reading].hint}>{readingTiers[t.reading].label}</span>}
        {t.reading && <span class="badge plain">النص كاملًا: {countWord(verses.length + t.omit.length, ['بيت واحد', 'بيتان', 'أبيات', 'بيتًا'])}</span>}
        {range && <span class="badge plain">{mixed ? 'المشروح منها شرحًا كاملًا' : 'الأبيات المشروحة'}: {range}</span>}
        <StatusBadge status={t.status} />
      </div>
    </header>
    <aside class="card aside-card">
      <dl>
        {t.meter && <div><dt>البحر</dt><dd>{t.meter}</dd></div>}
        {t.rhyme && <div><dt>القافية</dt><dd>{t.rhyme}</dd></div>}
        {t.year && <div><dt>زمن القول</dt><dd>{formatDate(t.year)}</dd></div>}
        {t.attribution && <div><dt>النسبة</dt><dd style="font-weight:400" set:html={fmt(t.attribution.note, sources)} /></div>}
      </dl>
    </aside>
  </div>

  {t.thesis && (
    <section class="thesis measure"><b>مفتاح القراءة</b><p set:html={fmt(t.thesis, sources)} /></section>
  )}

  <Body entry={text} />

  {t.map.length > 0 && (
    <section class="section">
      <div class="section-head"><span class="kicker">حركة المعنى</span><h2>خريطة الأبيات</h2>{t.movement && <p class="measure">{t.movement}</p>}</div>
      <div class="map-list">
        {t.map.map((m) => <article class="card"><span class="range">الأبيات {m.range}</span><h3>{m.title}</h3><p set:html={fmt(m.text, sources)} /></article>)}
      </div>
    </section>
  )}

  {verses.length > 0 && (
    <section class="section">
      <div class="section-head"><h2>النص وشرحه</h2><p>{!mixed
        ? 'اضغط أي بيت لتفتح شرحه: المعنى والمفردات، ثم النحو والصرف والبلاغة والوزن والمصادر.'
        : explained.length > 0
          ? 'اضغط البيت لتفتح مفرداته. والبيت الذي حول رقمه دائرة مشروح شرحًا كاملًا: المعنى والمفردات، ثم النحو والصرف والبلاغة والوزن والمصادر.'
          : 'اضغط البيت لتفتح مفرداته.'}</p></div>
      <VerseReader text={text.id} sections={t.reading && mixed ? t.map : []} />
    </section>
  )}

  {t.sources.length > 0 && (
    <section class="section measure">
      <div class="section-head"><h2>مصادر النص</h2></div>
      <CiteList items={t.sources} />
    </section>
  )}
</Base>
