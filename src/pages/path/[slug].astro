---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import CiteList from '../../components/CiteList.astro';
import Pager from '../../components/Pager.astro';
import Reading from '../../components/Reading.astro';
import VerseQuote from '../../components/VerseQuote.astro';
import Cite from '../../components/Cite.astro';
import ConceptCard from '../../components/ConceptCard.astro';
import PersonCard from '../../components/PersonCard.astro';
import StoryCard from '../../components/StoryCard.astro';
import Bayt from '../../components/Bayt.astro';
import Ago from '../../components/Ago.astro';
import MahfuzCard from '../../components/MahfuzCard.astro';
import { getPath, must, url, type PathPart } from '../../lib/content';
import { ordinals } from '../../lib/labels';

export async function getStaticPaths() {
  const path = await getPath();
  const written = path.flatMap((p) => p.stations.filter((s) => s.entry).map((s) => s.entry!));
  return [
    ...path.filter((p) => p.hasPage).map((part) => ({ params: { slug: part.entry.id }, props: { kind: 'part' as const, part } })),
    ...written.map((station, i) => ({
      params: { slug: station.id },
      props: {
        kind: 'station' as const,
        station,
        part: path.find((p) => p.entry.id === station.data.part.id)!,
        prev: written[i - 1],
        next: written[i + 1],
      },
    })),
  ];
}

type Props =
  | { kind: 'part'; part: PathPart }
  | { kind: 'station'; station: CollectionEntry<'stations'>; part: PathPart; prev?: CollectionEntry<'stations'>; next?: CollectionEntry<'stations'> };

const props = Astro.props as Props;
const partData = props.part.entry.data;
const partName = `الباب ${partData.number === 0 ? 'التمهيدي' : ordinals[partData.number - 1]}`;
const partCrumb = { href: props.part.hasPage ? url.part(props.part.entry.id) : '/#journey', label: `${partName}: ${partData.title}` };

let Content: any;
let station: CollectionEntry<'stations'> | undefined;
let mahfuzat: CollectionEntry<'mahfuzat'>[] = [];
if (props.kind === 'station') {
  station = props.station;
  ({ Content } = await render(station));
  const id = station.id;
  mahfuzat = (await getCollection('mahfuzat', (m) => m.data.station?.id === id)).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
}
const components = { Reading, VerseQuote, Cite, ConceptCard, PersonCard, StoryCard, Bayt, Ago };
---
{props.kind === 'part' ? (
  <Base title={partData.title} description={partData.summary}>
    <Crumbs items={[{ href: '/', label: 'المسار' }, { label: partName }]} />
    <header class="station-head">
      <span class="kicker">{partName}{partData.range && ` · ${partData.range}`}</span>
      <h1>{partData.title}</h1>
      {partData.summary && <p class="lede measure">{partData.summary}</p>}
      <div class="meta-row"><StatusBadge status={partData.status} /></div>
    </header>

    {partData.highlights.length > 0 && (
      <section>
        <div class="section-head"><span class="kicker">نظرة عامة</span><h2>ملامح مركزية</h2></div>
        <div class="grid four">
          {partData.highlights.map((h, i) => (
            <article class="card"><span class="num">{String(i + 1).padStart(2, '0')}</span><h3>{h.title}</h3><p>{h.text}</p></article>
          ))}
        </div>
      </section>
    )}

    {partData.deep.length > 0 && (
      <section class="section">
        <div class="section-head"><span class="kicker">بالتفصيل</span><h2>مكوّنات المشهد الأدبي</h2></div>
        <div class="grid two">
          {partData.deep.map((h) => <article class="card"><h3>{h.title}</h3><p>{h.text}</p></article>)}
        </div>
      </section>
    )}

    {partData.keyNames.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>أعلام يرسمون اتساع الباب</h2></div>
        <ul class="pill-list">{partData.keyNames.map((n) => <li>{n}</li>)}</ul>
      </section>
    )}

    <section class="section">
      <div class="section-head"><h2>محطات الباب</h2></div>
      <ol class="station-list card">
        {props.part.stations.map((s) => (
          <li data-station-id={s.entry?.id}>
            <span class="n">{s.number}</span>
            {s.entry ? <a href={url.station(s.entry.id)}>{s.title}</a> : <span class="planned">{s.title}</span>}
            <span class="done-mark" aria-label="أنهيتها">✓</span>
          </li>
        ))}
      </ol>
    </section>

    {partData.sources.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>المصادر</h2></div>
        <CiteList items={partData.sources} />
      </section>
    )}
  </Base>
) : (
  <Base title={`${station!.data.number} ${station!.data.title}`} description={station!.data.subtitle} searchType="محطة">
    <Crumbs items={[{ href: '/', label: 'المسار' }, partCrumb, { label: `المحطة ${station!.data.number}` }]} />
    <header class="station-head">
      <div class="station-number" aria-hidden="true">{station!.data.number}</div>
      <h1>{station!.data.title}</h1>
      {station!.data.subtitle && <p class="lede measure">{station!.data.subtitle}</p>}
      <div class="meta-row">
        {station!.data.minutes && <span>نحو {station!.data.minutes} دقيقة قراءة</span>}
        <StatusBadge status={station!.data.status} />
      </div>
    </header>

    <div class="prose station-body">
      <Content components={components} />
    </div>

    {station!.data.outcomes.length > 0 && (
      <section class="section measure">
        <div class="section-head"><span class="kicker">الحصيلة</span><h2>ما الذي خرجت به من هذه المحطة؟</h2></div>
        <ol class="outcomes">{station!.data.outcomes.map((o) => <li><span>{o}</span></li>)}</ol>
      </section>
    )}

    {mahfuzat.length > 0 && (
      <section class="section measure">
        <div class="section-head"><span class="kicker">المحفوظات</span><h2>ما يبقى معك من هذه المحطة</h2><p>تجدها كلها مع محفوظات العصور الأخرى في <a href="/mahfuzat/">المحفوظات</a>.</p></div>
        <div class="mahfuz-list">{mahfuzat.map((m) => <MahfuzCard item={m} showStation={false} />)}</div>
      </section>
    )}

    {station!.data.review.length > 0 && (
      <section class="section measure review" data-pagefind-ignore>
        <div class="section-head"><span class="kicker">مراجعة</span><h2>اختبر فهمك</h2><p>حاول أن تجيب قبل أن تفتح الجواب.</p></div>
        {station!.data.review.map((r) => <details><summary>{r.q}</summary><p>{r.a}</p></details>)}
      </section>
    )}

    {station!.data.sources.length > 0 && (
      <section class="section measure">
        <div class="section-head"><h2>مصادر المحطة</h2></div>
        <CiteList items={station!.data.sources} />
      </section>
    )}

    <div class="section measure" data-pagefind-ignore>
      <button type="button" class="btn" data-done-toggle={station!.id} aria-pressed="false">أنهيت هذه المحطة</button>
    </div>

    <Pager
      prev={props.kind === 'station' && props.prev ? { href: url.station(props.prev.id), label: `المحطة ${props.prev.data.number}`, title: props.prev.data.title } : undefined}
      next={props.kind === 'station' && props.next ? { href: url.station(props.next.id), label: `المحطة ${props.next.data.number}`, title: props.next.data.title } : undefined}
    />
  </Base>
)}
