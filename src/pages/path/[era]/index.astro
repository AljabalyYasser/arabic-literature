---
// صفحة العصر: تقول للقارئ أين هو وما الذي سيدرسه، ولا تكون هي الدراسة نفسها.
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import CiteList from '../../../components/CiteList.astro';
import { ago, countWord, fmt, getEras, nameGen, sourceMap, stripCites, url, type Era, type Slot } from '../../../lib/content';
import { ordinals, tiers } from '../../../lib/labels';

export async function getStaticPaths() {
  return (await getEras()).filter((e) => e.hasPage).map((era) => ({ params: { era: era.entry.id }, props: { era } }));
}

const { era } = Astro.props as { era: Era };
const d = era.entry.data;
const eraName = `الباب ${d.number === 0 ? 'التمهيدي' : ordinals[d.number - 1]}`;
const slots = [
  { key: 'formative' as const, list: era.formative },
  { key: 'important' as const, list: era.important },
];
const written = (list: Slot[]) => list.filter((s) => s.entry).length;
const ov = d.overview;
const sources = await sourceMap();
// الفقرات يفصل بينها سطر فارغ.
const paras = (t: string) => t.split(/\n\s*\n/).map((x) => x.trim()).filter(Boolean);
// فهرس أقسام الصفحة بترتيبها، ليصل القارئ إلى الطريق والأعلام والوجوه دون أن يبحث عنها.
const toc = [
  ov && { id: 'history', title: 'ماذا حدث؟' },
  ov && { id: 'change', title: 'ما الذي تغيّر؟' },
  ov && ov.arts.length > 0 && { id: 'arts', title: 'الفنون' },
  ov && (ov.books.length > 0 || ov.booksLater.length > 0) && { id: 'books', title: 'الكتب' },
  ov && ov.texts.length > 0 && { id: 'texts', title: 'نصوص صنعت العصر' },
  era.route.length > 0 && { id: 'route', title: 'الطريق المقترح' },
  era.topics.length > 0 && { id: 'topics', title: 'القضايا' },
  (era.formative.length > 0 || era.important.length > 0) && { id: 'alam', title: 'الأعلام' },
  era.groups.length > 0 && { id: 'faces', title: 'الوجوه في مجموعات' },
].filter(Boolean) as { id: string; title: string }[];
---
<Base title={d.title} description={stripCites(d.summary) ?? `${d.title}: قضاياه وأعلامه والطريق المقترح لقراءته.`} searchType="عصر">
  <Crumbs items={[{ href: '/', label: 'المسار' }, { label: eraName }]} />
  <header class="station-head">
    <span class="kicker">{eraName}{d.range && ` · ${d.range}`}{d.start && <> · <span class="ago">بدأ {ago(d.start, true)}</span></>}</span>
    <h1>{d.title}</h1>
    {d.summary && <p class="lede measure" set:html={fmt(d.summary, sources)} />}
    <div class="meta-row"><StatusBadge status={d.status} /></div>
    {d.caveat && <p class="note-box measure" set:html={fmt(d.caveat, sources)} />}
    {toc.length > 2 && (
      <nav class="page-toc" aria-label="أقسام الصفحة">
        <b>في هذه الصفحة</b>
        <ul class="pill-list">{toc.map((t) => <li><a href={`#${t.id}`}>{t.title}</a></li>)}</ul>
      </nav>
    )}
  </header>

  {ov && (
    <div class="era-map">
      <section class="section measure" id="history">
        <div class="section-head"><span class="kicker">أين أنت؟</span><h2>ماذا حدث؟</h2></div>
        {paras(ov.history).map((t) => <p set:html={fmt(t, sources)} />)}
      </section>

      <section class="section measure" id="change">
        <div class="section-head"><h2>ما الذي تغيّر في اللغة والأدب؟</h2></div>
        {paras(ov.change).map((t) => <p set:html={fmt(t, sources)} />)}
      </section>

      {ov.arts.length > 0 && (
        <section class="section" id="arts">
          <div class="section-head"><h2>الفنون التي برزت</h2></div>
          <div class="grid two">
            {ov.arts.map((a) => <article class="card"><h3>{a.title}</h3><p set:html={fmt(a.text, sources)} /></article>)}
          </div>
        </section>
      )}

      {ov.poets.length === 0 && era.formative.length > 0 && (
        <section class="section measure">
          <div class="section-head"><h2>أهم الشعراء</h2><p>{tiers.formative.plural}، وتجدهم مع {tiers.important.plural} و{tiers.face.plural} في <a href="#alam">أعلام العصر</a>.</p></div>
          <ul class="pill-list">
            {era.formative.map((s) => s.entry ? <li><a href={url.person(s.id)}>{s.name}</a></li> : <li class="planned">{s.name}</li>)}
          </ul>
        </section>
      )}

      {[{ title: 'أهم الشعراء', list: ov.poets, note: ov.notes.poets }, { title: ov.writersTitle ?? 'الأدباء والكتّاب والنقاد', list: ov.writers, note: ov.notes.writers }].filter((g) => g.list.length > 0).map((g) => (
        <section class="section measure">
          <div class="section-head"><h2>{g.title}</h2></div>
          <ul class="name-list">
            {g.list.map((n) => <li><b>{n.person ? <a href={url.person(n.person.id)} set:html={fmt(n.name, sources)} /> : <Fragment set:html={fmt(n.name, sources)} />}</b> <span set:html={fmt(n.text, sources)} /></li>)}
          </ul>
          {g.note && <p class="era-note" set:html={fmt(g.note, sources)} />}
        </section>
      ))}

      {(ov.books.length > 0 || ov.booksLater.length > 0) && (
        <section class="section measure" id="books">
          <div class="section-head"><h2>أهم الكتب</h2></div>
          <h3 class="list-head">من آثار العصر وأهله</h3>
          {ov.books.length > 0 && <ul class="name-list">{ov.books.map((k) => <li><b>{k.title}</b> <span set:html={fmt(k.text, sources)} /></li>)}</ul>}
          {ov.notes.books && <p class="era-note" set:html={fmt(ov.notes.books, sources)} />}
          {ov.booksLater.length > 0 && (
            <>
              <h3 class="list-head">كتب لاحقة نقرأ بها العصر</h3>
              <ul class="name-list">{ov.booksLater.map((k) => <li><b>{k.title}</b> <span set:html={fmt(k.text, sources)} /></li>)}</ul>
            </>
          )}
        </section>
      )}

      {ov.texts.length > 0 && (
        <section class="section measure" id="texts">
          <div class="section-head"><h2>نصوص صنعت العصر</h2></div>
          <ul class="name-list">{ov.texts.map((k) => <li><b>{k.text_id ? <a href={url.text(k.text_id.id)}>{k.title}</a> : k.title}</b> <span set:html={fmt(k.text, sources)} /></li>)}</ul>
          {ov.notes.texts && <p class="era-note" set:html={fmt(ov.notes.texts, sources)} />}
        </section>
      )}
    </div>
  )}

  {(era.route.length > 0 || d.plan.length > 0) && (
    <div class="section-head study-head"><span class="kicker">ما الذي ستدرسه؟</span><h2>{era.route.length > 0 ? 'قراءة العصر' : 'خطة العصر'}</h2></div>
  )}

  {era.route.length === 0 && d.plan.length > 0 && (
    <section class="section">
      <p class="measure muted">خطة مسودة تُراجع قبل كتابة العصر، وتُبنى عليها قضاياه وأعلامه بدرجاتهم الثلاث بعد مسح أعلامه.</p>
      <ol class="station-list card">
        {d.plan.map((s) => <li><span class="n">{s.number}</span><span class="planned">{s.title}</span><span></span></li>)}
      </ol>
    </section>
  )}

  {era.route.length > 0 && (
    <section class="section" id="route">
      <div class="section-head">
        <span class="kicker">من أين تبدأ؟</span>
        <h2>الطريق المقترح</h2>
        <p class="measure">ابدأ بقضايا العصر، ثم اقرأ أعلامه. والطريق مقترح، ولك أن تخرج عنه متى شئت.</p>
      </div>
      <ol class="station-list card">
        {era.route.map((item, i) => item.kind === 'topic' ? (
          <li data-station-id={item.slot.entry && `${era.entry.id}/${item.slot.id}`}>
            <span class="n">{i + 1}</span>
            {item.slot.entry ? <a href={url.chapter(item.slot.entry.id)}>{item.slot.title}</a> : <span class="planned">{item.slot.title}</span>}
            <span class="done-mark" aria-label="أنهيتها">✓</span>
          </li>
        ) : (
          <li data-done-all={item.stages.map((s) => s.id).join(' ')}>
            <span class="n">{i + 1}</span>
            <span><a href={url.person(item.person.id)}>مسار {nameGen(item.person)}</a> <span class="sub">{countWord(item.stages.length, ['مرحلة واحدة', 'مرحلتان', 'مراحل', 'مرحلة'])}</span></span>
            <span class="done-mark" aria-label="أنهيته">✓</span>
          </li>
        ))}
      </ol>
    </section>
  )}

  {era.topics.length > 0 && (
    <section class="section" id="topics">
      <div class="section-head">
        <span class="kicker">قضايا العصر</span>
        <h2>ما يلزم لفهم العصر</h2>
        <p class="measure">معرفة لا تخص علمًا بعينه ولا كتابًا بعينه.</p>
      </div>
      <ol class="station-list card">
        {era.topics.map((t, i) => (
          <li data-station-id={t.entry?.id}>
            <span class="n">{i + 1}</span>
            {t.entry ? <a href={url.chapter(t.entry.id)}>{t.title}</a> : <span class="planned">{t.title}</span>}
            <span class="done-mark" aria-label="أنهيتها">✓</span>
          </li>
        ))}
      </ol>
    </section>
  )}

  {(era.formative.length > 0 || era.important.length > 0 || era.groups.length > 0) && (
    <section class="section" id="alam">
      <div class="section-head">
        <span class="kicker">الأعلام</span>
        <h2>أعلام {d.title}</h2>
        <p class="measure">لا نقرأ الأعلام كلهم بالقدر نفسه، بل على ثلاث درجات. والأسماء الباهتة لم تُكتب صفحاتها بعد.</p>
      </div>

      {slots.filter((s) => s.list.length > 0).map(({ key, list }) => (
        <div class="tier-block">
          <h3>{tiers[key].plural} <span class="sub">{written(list)} من {list.length}</span></h3>
          <p class="muted small">{tiers[key].hint}</p>
          <ul class="pill-list">
            {list.map((s) => s.entry ? <li><a href={url.person(s.id)}>{s.name}</a></li> : <li class="planned">{s.name}</li>)}
          </ul>
        </div>
      ))}

      {era.groups.length > 0 && (
        <div class="tier-block" id="faces">
          <h3>{tiers.face.plural}</h3>
          <p class="muted small">{tiers.face.hint}</p>
          <ol class="group-list">
            {era.groups.map((g) => (
              <li>
                <span class="n">{g.number}</span>
                <div>
                  {g.hasPage ? <a class="title" href={url.group(g.era, g.id)}>{g.title}</a> : <span class="title planned">{g.title}</span>}
                  {g.faces.length > 0 && (
                    <ul class="pill-list">{g.faces.map((f) => <li><a href={url.personOf(f)}>{f.data.name}</a></li>)}</ul>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      )}
    </section>
  )}

  {era.referred.length > 0 && (
    <section class="section">
      <div class="section-head"><h2>أعلام أدركوا هذا العصر ونقرؤهم في غيره</h2></div>
      <ul class="pill-list">{era.referred.map((p) => <li><a href={url.personOf(p)}>{p.data.name}</a></li>)}</ul>
    </section>
  )}

  {d.sources.length > 0 && (
    <section class="section">
      <div class="section-head"><h2>المصادر</h2></div>
      <CiteList items={d.sources} />
    </section>
  )}
</Base>
