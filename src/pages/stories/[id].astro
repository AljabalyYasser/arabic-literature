---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import CiteList from '../../components/CiteList.astro';
import Body from '../../components/Body.astro';
import { fmt, mustAll, sourceMap, stripCites, url } from '../../lib/content';
import { storyGrades } from '../../lib/labels';

export async function getStaticPaths() {
  return (await getCollection('stories')).map((story) => ({ params: { id: story.id }, props: { story } }));
}

const { story } = Astro.props as { story: CollectionEntry<'stories'> };
const s = story.data;
const people = await mustAll(s.people);
const grade = storyGrades[s.grade];
const sources = await sourceMap();
---
<Base title={s.title} description={stripCites(s.summary)} searchType="حكاية">
  <Crumbs items={[{ href: '/stories/', label: 'الحكايات' }, { label: s.title }]} />
  <header class="station-head">
    <span class="kicker">حكاية</span>
    <h1>{s.title}</h1>
    <p class="lede measure">{s.summary}</p>
    <div class="meta-row"><span class={`badge grade-${s.grade}`} title={grade.hint}>{grade.label}</span><StatusBadge status={s.status} /></div>
  </header>

  <Body entry={story} />

  <section class="section measure">
    <div class="note-box">
      <b>درجة الخبر: {grade.label}</b>
      <p set:html={fmt(s.gradeReason, sources)} />
    </div>
    <div class="section-head" style="margin-top:1.5rem"><h3>أقدم مصدر ذكره</h3></div>
    <CiteList items={[s.earliest]} />
  </section>

  {people.length > 0 && (
    <section class="section measure">
      <div class="section-head"><h2>أشخاص الحكاية</h2></div>
      <ul class="pill-list">{people.map((p) => <li><a href={url.person(p.id)}>{p.data.name}</a></li>)}</ul>
    </section>
  )}

  {s.sources.length > 0 && (
    <section class="section measure">
      <div class="section-head"><h2>مصادر أخرى</h2></div>
      <CiteList items={s.sources} />
    </section>
  )}
</Base>
