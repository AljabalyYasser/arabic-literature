---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import { storyGrades, storyTags } from '../../lib/labels';

const stories = await getCollection('stories');
---
<Base title="الحكايات">
  <header class="station-head">
    <span class="kicker"><a href="/texts/">النصوص</a></span>
    <h1>الحكايات والأخبار الأدبية</h1>
    <p class="lede measure">أخبار الشعراء ومجالسهم ومواقفهم، مروية بمتعتها، ومعها درجة روايتها وأقدم مصدر ذكرها.</p>
    <ul class="pill-list" style="margin-top:1rem">
      {Object.entries(storyGrades).map(([key, g]) => <li><span class={`badge grade-${key}`}>{g.label}</span> <span class="muted small">{g.hint}</span></li>)}
      {Object.values(storyTags).map((t) => <li><span class="badge story-tag">{t.label}</span> <span class="muted small">{t.hint}</span></li>)}
    </ul>
  </header>
  {stories.length > 0
    ? <div class="grid two">{stories.map((s) => <StoryCard id={s.id} />)}</div>
    : <p class="muted">تُضاف الحكايات مع قراءات المسار.</p>}
</Base>
