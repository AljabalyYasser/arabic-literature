---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import CiteList from '../../components/CiteList.astro';
import Body from '../../components/Body.astro';
import { formatDate, url } from '../../lib/content';
import { personKinds, textKinds } from '../../lib/labels';

export async function getStaticPaths() {
  return (await getCollection('people')).map((person) => ({ params: { id: person.id }, props: { person } }));
}

const { person } = Astro.props as { person: CollectionEntry<'people'> };
const p = person.data;
const texts = await getCollection('texts', (t) => t.data.author?.id === person.id);
const stations = (await getCollection('stations', (s) => s.data.people.some((r) => r.id === person.id)));
const stories = await getCollection('stories', (s) => s.data.people.some((r) => r.id === person.id));
---
<Base title={p.name} description={p.summary} searchType="علَم">
  <Crumbs items={[{ href: '/people/', label: 'الأعلام' }, { label: p.name }]} />
  <div class="entity-head with-aside">
    <header>
      <span class="kicker">{p.kinds.map((k) => personKinds[k]).join('، ')}</span>
      <h1>{p.name}</h1>
      <p class="lede">{p.summary}</p>
      <div class="meta-row"><StatusBadge status={p.status} /></div>
    </header>
    <aside class="card aside-card">
      <dl>
        {p.fullName && <div><dt>الاسم</dt><dd>{p.fullName}</dd></div>}
        {p.born && <div><dt>المولد</dt><dd>{formatDate(p.born)}</dd></div>}
        {p.died && <div><dt>الوفاة</dt><dd>{formatDate(p.died)}</dd></div>}
      </dl>
    </aside>
  </div>

  {p.placement && (
    <section class="thesis measure"><b>موضعه من عصره</b><p>{p.placement}</p></section>
  )}

  <Body entry={person} />

  {p.readingKeys.length > 0 && (
    <section class="section">
      <div class="section-head"><span class="kicker">مفاتيح القراءة</span><h2>كيف نقرأ {p.name}؟</h2></div>
      <div class="grid two">
        {p.readingKeys.map((k, i) => <article class="card"><span class="num">{String(i + 1).padStart(2, '0')}</span><h3>{k.title}</h3><p>{k.text}</p></article>)}
      </div>
    </section>
  )}

  {p.timeline.length > 0 && (
    <section class="section measure deep-only">
      <div class="section-head"><span class="kicker">السيرة سياقًا</span><h2>خط زمني</h2></div>
      <ol class="timeline">{p.timeline.map((t) => <li><time>{t.year}</time><p>{t.text}</p></li>)}</ol>
    </section>
  )}

  {(texts.length > 0 || stations.length > 0 || stories.length > 0) && (
    <section class="section">
      <div class="section-head"><h2>في المسار والمرجع</h2></div>
      <div class="grid two">
        {texts.map((t) => <a class="card link-card" href={url.text(t.id)}><span class="kicker">{textKinds[t.data.kind]}</span><h3>{t.data.title}</h3></a>)}
        {stations.map((s) => <a class="card link-card" href={url.station(s.id)}><span class="kicker">المحطة {s.data.number}</span><h3>{s.data.title}</h3></a>)}
        {stories.map((s) => <a class="card link-card" href={url.story(s.id)}><span class="kicker">حكاية</span><h3>{s.data.title}</h3></a>)}
      </div>
    </section>
  )}

  {p.sources.length > 0 && (
    <section class="section measure deep-only">
      <div class="section-head"><h2>المصادر</h2></div>
      <CiteList items={p.sources} />
    </section>
  )}
</Base>
